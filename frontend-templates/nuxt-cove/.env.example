# ElmapiCMS (server-only API key — never expose to the browser)
ELMAPI_BASE_URL=https://your-instance.example/api
ELMAPI_PROJECT_ID=your-project-uuid
ELMAPI_API_KEY=your-project-api-token

# Public site URL used for canonical URLs, OG tags, and sitemap fallback
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables webhook-based cache refresh (see README)
REVALIDATE_SECRET=

# In-process CMS cache TTL in seconds (default 3600). Use 0 for always-live
# fetches while editing content without webhooks. Rebuild after changing.
# CMS_CACHE_MAX_AGE=3600

# Local Herd / self-signed TLS only (development)
# NODE_TLS_REJECT_UNAUTHORIZED=0

