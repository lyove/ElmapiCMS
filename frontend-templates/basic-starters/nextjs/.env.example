# ElmapiCMS instance API root (include /api)
ELMAPI_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
ELMAPI_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only, never NEXT_PUBLIC_)
ELMAPI_API_KEY=

# NextAuth / Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Optional: public site origin for absolute links / metadata fallbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node.js: set to 0 only for local dev with self-signed TLS (e.g. Laravel Herd)
# NODE_TLS_REJECT_UNAUTHORIZED=0
