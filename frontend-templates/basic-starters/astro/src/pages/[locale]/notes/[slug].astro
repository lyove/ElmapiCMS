---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RichText from "../../../components/RichText.astro";
import { getNoteBySlug } from "../../../lib/content";
import { localePath } from "../../../lib/i18n";
import { loadPageChrome, resolveLocale } from "../../../lib/page-context";
import { richTextToHtml } from "../../../lib/rich-text";
import { ElmapiError } from "@elmapicms/js-sdk";

const locale = await resolveLocale(Astro.params.locale);
const chrome = await loadPageChrome(locale, Astro.cookies);
const slug = String(Astro.params.slug || "");

let note = null;
let loadError: string | null = null;
try {
  note = await getNoteBySlug(locale, slug);
} catch (error) {
  if (error instanceof ElmapiError) {
    loadError = chrome.dictionary.errors.loadFailed;
  } else {
    throw error;
  }
}

if (!note && !loadError) {
  return Astro.redirect(localePath(locale, "/notes"));
}

const html = note ? richTextToHtml(note.fields.body) : "";
---

<BaseLayout
  locale={locale}
  dictionary={chrome.dictionary}
  siteName={chrome.siteName}
  title={note?.fields["seo-title"] || note?.fields.title || chrome.siteName}
  description={note?.fields["seo-description"] || chrome.description}
  signedIn={chrome.signedIn}
>
  <article class="space-y-6">
    {
      loadError ? (
        <p class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-800">
          {loadError}
        </p>
      ) : note ? (
        <>
          <div>
            <a
              href={localePath(locale, "/notes")}
              class="text-sm text-zinc-500 underline underline-offset-2"
            >
              {chrome.dictionary.notes.backToList}
            </a>
            <h1 class="mt-3 text-2xl font-semibold tracking-tight">
              {note.fields.title}
            </h1>
            {note.fields["author-name"] ? (
              <p class="mt-1 text-sm text-zinc-500">
                {chrome.dictionary.notes.author}: {note.fields["author-name"]}
              </p>
            ) : null}
          </div>
          <RichText html={html} />
        </>
      ) : null
    }
  </article>
</BaseLayout>
