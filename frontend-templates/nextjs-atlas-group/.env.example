# ElmapiCMS instance API root (include /api)
ELMAPI_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
ELMAPI_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only)
ELMAPI_API_KEY=

# Optional fallback when site-url is unset in CMS (used for canonical/OG in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret for Elmapi webhooks that refresh the page cache (server-only).
# When set, webhooks invalidate affected paths immediately; the 1-hour ISR baseline still applies.
# Set the same value in the webhook Secret field in Elmapi project settings.
# REVALIDATE_SECRET=

# Optional: map Elmapi collection_id → slug for delete/trash webhooks without content_entry.
# Find IDs in webhook delivery logs. Example:
# REVALIDATION_COLLECTION_IDS={"12":"services","13":"blog-posts"}

# Node.js: set to 0 only for local dev with self-signed TLS (e.g. Laravel Herd)
# NODE_TLS_REJECT_UNAUTHORIZED=0
