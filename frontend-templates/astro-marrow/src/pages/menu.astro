---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuTicket from '../components/MenuTicket.astro';
import Reveal from '../components/Reveal.astro';
import {
  getMenuCategories,
  getMenuItems,
  getPageMenu,
  getSiteSettings,
  groupMenuItemsByCategory,
} from '../lib/content';
import { buildSeo } from '../lib/seo';

const [settings, page, categories, items] = await Promise.all([
  getSiteSettings(),
  getPageMenu(),
  getMenuCategories(),
  getMenuItems(),
]);

const fields = page?.fields;
const sections = groupMenuItemsByCategory(categories, items);

const seo = buildSeo({
  settings,
  page: fields,
  path: '/menu',
  fallbackTitle: fields?.headline || 'Menu',
  fallbackDescription: fields?.intro,
});
---

<BaseLayout settings={settings} seo={seo}>
  <section class="container-wide py-14 sm:py-20">
    <p class="section-label hero-rise">Our menu</p>
    <h1 class="section-title mt-3 max-w-3xl hero-rise hero-rise-delay-1">
      {fields?.headline || 'Menu'}
    </h1>
    {fields?.intro && (
      <p class="mt-4 max-w-2xl text-lg text-forest/75 hero-rise hero-rise-delay-2">{fields.intro}</p>
    )}
  </section>

  <section class="container-wide pb-20">
    <Reveal>
      {sections.some((s) => s.items.length > 0) ? (
        <MenuTicket sections={sections} showImages={true} />
      ) : (
        <p class="text-forest/70">Menu coming soon.</p>
      )}
    </Reveal>
  </section>
</BaseLayout>
