---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import Reveal from '../components/Reveal.astro';
import RichText from '../components/RichText.astro';
import { getFaqs, getPageVisit, getSiteSettings } from '../lib/content';
import { renderRichText } from '../lib/rich-text';
import { buildSeo } from '../lib/seo';

const [settings, page, faqs] = await Promise.all([
  getSiteSettings(),
  getPageVisit(),
  getFaqs(),
]);

const fields = page?.fields;
const siteFields = settings?.fields;
const visitNotesHtml = renderRichText(fields?.['visit-notes']);
const hoursHtml = renderRichText(siteFields?.hours);
const reserveHref = siteFields?.['reservation-url'] || '/reserve';
const reserveExternal = /^https?:\/\//i.test(reserveHref);

const seo = buildSeo({
  settings,
  page: fields,
  path: '/visit',
  fallbackTitle: fields?.headline || 'Visit',
  fallbackDescription: fields?.intro,
});
---

<BaseLayout settings={settings} seo={seo}>
  <section class="container-wide py-14 sm:py-20">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="section-label hero-rise">Find us</p>
        <h1 class="section-title mt-3 hero-rise hero-rise-delay-1">
          {fields?.headline || 'Visit'}
        </h1>
        {fields?.intro && (
          <p class="mt-4 max-w-2xl text-lg text-forest/75 hero-rise hero-rise-delay-2">{fields.intro}</p>
        )}
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end hero-rise hero-rise-delay-3">
        <a
          href={reserveHref}
          class="btn-primary"
          target={reserveExternal ? '_blank' : undefined}
          rel={reserveExternal ? 'noopener noreferrer' : undefined}
        >
          Reserve a table
        </a>
        {siteFields?.phone && (
          <a href={`tel:${siteFields.phone.replace(/\s/g, '')}`} class="btn-secondary">
            Call us
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="container-wide pb-12">
    <div class="grid gap-6 lg:grid-cols-3">
      <Reveal>
        <div class="h-full rounded-[1.75rem] bg-foam p-6 shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] sm:p-8">
          <p class="section-label">Address</p>
          {siteFields?.address ? (
            <p class="mt-3 whitespace-pre-line text-lg text-coal">{siteFields.address}</p>
          ) : (
            <p class="mt-3 text-forest/70">Address coming soon.</p>
          )}
          <div class="mt-6 space-y-2">
            {siteFields?.phone && (
              <a href={`tel:${siteFields.phone.replace(/\s/g, '')}`} class="block font-semibold text-ember">
                {siteFields.phone}
              </a>
            )}
            {siteFields?.email && (
              <a href={`mailto:${siteFields.email}`} class="block font-semibold text-ember">
                {siteFields.email}
              </a>
            )}
          </div>
        </div>
      </Reveal>

      <Reveal>
        <div class="h-full rounded-[1.75rem] bg-foam p-6 shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] sm:p-8">
          <p class="section-label">Hours</p>
          {hoursHtml ? (
            <div class="mt-3 space-y-1 text-sm leading-relaxed text-forest/80" set:html={hoursHtml} />
          ) : (
            <p class="mt-3 text-forest/70">Hours coming soon.</p>
          )}
          <p class="mt-6 text-sm text-forest/60">Closed Mondays. Kitchen closes 30 minutes before last seating.</p>
        </div>
      </Reveal>

      <Reveal>
        <div class="h-full rounded-[1.75rem] bg-forest p-6 text-foam sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage">Tonight</p>
          <p class="mt-3 font-display text-2xl font-bold tracking-tight">
            Walk-ins welcome early. Weekends book ahead.
          </p>
          <a
            href={reserveHref}
            class="btn-primary mt-6 !bg-ember"
            target={reserveExternal ? '_blank' : undefined}
            rel={reserveExternal ? 'noopener noreferrer' : undefined}
          >
            Request a table
          </a>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="container-wide pb-20">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <Reveal>
        {visitNotesHtml ? (
          <div class="rounded-[1.75rem] bg-foam p-6 shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] sm:p-8">
            <p class="section-label">Good to know</p>
            <div class="prose-marrow mt-4">
              <RichText html={visitNotesHtml} />
            </div>
          </div>
        ) : null}
      </Reveal>

      <Reveal>
        {fields?.['map-embed-url'] ? (
          <div class="aspect-[4/3] overflow-hidden rounded-[1.75rem] shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] lg:aspect-auto lg:min-h-[28rem]">
            <iframe
              src={fields['map-embed-url']}
              title="Map to Marrow"
              class="h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        ) : (
          <div class="flex min-h-[22rem] flex-col justify-between rounded-[1.75rem] border border-dashed border-forest/20 bg-foam p-8">
            <div>
              <p class="section-label">Neighborhood</p>
              <p class="mt-3 font-display text-2xl font-bold tracking-tight text-coal">
                Southeast Portland, on Willow Street
              </p>
              <p class="mt-3 max-w-sm text-forest/70">
                Street parking nearby, bike racks out front, and a short walk from the Hawthorne bus line.
              </p>
            </div>
            <p class="text-sm text-forest/50">Add a map embed URL in Visit page settings for a live map.</p>
          </div>
        )}
      </Reveal>
    </div>

    <div class="mt-16">
      <FaqList faqs={faqs} />
    </div>
  </section>
</BaseLayout>
