ELMAPI_BASE_URL=https://your-instance.example/api
ELMAPI_PROJECT_ID=
ELMAPI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: webhook revalidation (ISR + on-demand path invalidation)
# REVALIDATE_SECRET=
# Map Elmapi collection IDs to template slugs for faster webhook routing
# REVALIDATION_COLLECTION_IDS={"12":"services","13":"projects"}

# Local Herd / self-signed .test hosts only. Never set in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
