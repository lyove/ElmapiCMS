---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroFeast from '../components/HeroFeast.astro';
import Reveal from '../components/Reveal.astro';
import RichText from '../components/RichText.astro';
import { getMediaAlt, getMediaUrl } from '../lib/assets';
import {
  formatPrice,
  getGalleryImages,
  getHomePage,
  getJournalPosts,
  getPageAbout,
  getPagePrivateDining,
  getSiteSettings,
  parseDietary,
} from '../lib/content';
import { renderRichText } from '../lib/rich-text';
import { buildSeo } from '../lib/seo';
import type { ContentEntry, MenuItemFields } from '../lib/types';

const [settings, page, about, gallery, journal, privateDining] = await Promise.all([
  getSiteSettings(),
  getHomePage(),
  getPageAbout(),
  getGalleryImages(),
  getJournalPosts(),
  getPagePrivateDining(),
]);

const fields = page?.fields;
const featured = (fields?.['featured-dishes'] || []) as ContentEntry<MenuItemFields>[];
const thesisHtml = renderRichText(fields?.['thesis-body']);
const aboutHtml = renderRichText(about?.fields?.body);
const siteName = settings?.fields['site-name'] || 'Marrow';

const feastDishes = featured
  .map((d) => ({
    src: getMediaUrl(d.fields.image) || '',
    alt: getMediaAlt(d.fields.image, d.fields.name || 'Dish'),
    label: d.fields.name,
  }))
  .filter((img) => Boolean(img.src));

const heroFeast = getMediaUrl(fields?.['hero-image'])
  ? {
      src: getMediaUrl(fields?.['hero-image'])!,
      alt: getMediaAlt(fields?.['hero-image'], siteName),
      label: fields?.['hero-eyebrow'] || 'Tonight at Marrow',
    }
  : feastDishes[0]
    ? { ...feastDishes[0], label: 'Tonight at Marrow' }
    : null;

const galleryPreview = gallery.slice(0, 6);
const journalPreview = journal.slice(0, 2);

const values = [
  {
    title: 'Market first',
    body: 'We buy close when we can and cook what looks alive that morning.',
  },
  {
    title: 'Fire and cast iron',
    body: 'Wood, heat, and patience. The plate should taste like attention.',
  },
  {
    title: 'A neighborhood table',
    body: 'Come for a weeknight two-top or a longer night with wine.',
  },
];

const seo = buildSeo({
  settings,
  page: fields,
  path: '/',
  fallbackTitle: fields?.['hero-headline'],
  fallbackDescription: fields?.['hero-subhead'] || settings?.fields['seo-description'],
});
---

<BaseLayout settings={settings} seo={seo}>
  <PageHero
    brand={siteName}
    eyebrow={fields?.['hero-eyebrow'] || 'Best taste on Willow Street'}
    headline={fields?.['hero-headline'] || 'Dinner that tastes like the market'}
    subhead={fields?.['hero-subhead']}
    ctaLabel={fields?.['hero-cta-label'] || 'Get menu'}
    ctaUrl={fields?.['hero-cta-url'] || '/menu'}
    secondaryCtaLabel="Plan a visit"
    secondaryCtaUrl="/visit"
    align="center"
    size="home"
  />

  <HeroFeast hero={heroFeast} dishes={feastDishes} />

  {/* About / thesis */}
  <section class="container-wide py-16 sm:py-24">
    <Reveal>
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-6">
          {getMediaUrl(fields?.['thesis-image'] || about?.fields?.['atmosphere-image']) && (
            <div class="relative">
              <div class="aspect-[4/5] overflow-hidden rounded-[2rem] shadow-[0_30px_70px_-35px_rgba(21,32,25,0.5)]">
                <img
                  src={getMediaUrl(fields?.['thesis-image'] || about?.fields?.['atmosphere-image'])!}
                  alt={getMediaAlt(
                    fields?.['thesis-image'] || about?.fields?.['atmosphere-image'],
                    'Inside Marrow',
                  )}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              {getMediaUrl(about?.fields?.['portrait-image']) && (
                <div class="absolute -bottom-8 -right-4 aspect-square w-36 overflow-hidden rounded-full border-4 border-foam shadow-xl sm:w-44 lg:-right-8">
                  <img
                    src={getMediaUrl(about?.fields?.['portrait-image'])!}
                    alt={getMediaAlt(about?.fields?.['portrait-image'], 'Kitchen')}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          )}
        </div>

        <div class="lg:col-span-6 lg:pl-4">
          <p class="section-label">{about?.fields?.eyebrow || 'About us'}</p>
          <h2 class="section-title mt-3">
            {fields?.['thesis-headline'] || about?.fields?.headline || 'Captivating culinary favorites'}
          </h2>
          {(thesisHtml || aboutHtml) && (
            <div class="mt-6 max-w-xl">
              <RichText html={thesisHtml || aboutHtml} />
            </div>
          )}
          {about?.fields?.['pull-quote'] && (
            <blockquote class="mt-8 border-l-4 border-ember pl-5 font-display text-xl font-semibold text-coal">
              {about.fields['pull-quote']}
            </blockquote>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/about" class="btn-outline">About Marrow</a>
            <a href="/menu" class="btn-primary">Get menu</a>
          </div>
        </div>
      </div>
    </Reveal>
  </section>

  {/* Values */}
  <section class="container-wide pb-8 sm:pb-12">
    <Reveal>
      <div class="rounded-[2rem] bg-forest px-6 py-12 text-foam sm:px-10 sm:py-14">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sage">Why guests return</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
            The choice for a proper neighborhood dinner
          </h2>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {values.map((value) => (
            <article class="rounded-2xl bg-foam/8 p-6 ring-1 ring-foam/10 backdrop-blur">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-ember/90 text-sm font-bold">
                {value.title.slice(0, 1)}
              </div>
              <h3 class="font-display text-xl font-bold">{value.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-foam/75">{value.body}</p>
            </article>
          ))}
        </div>
      </div>
    </Reveal>
  </section>

  {/* Featured dishes */}
  {featured.length > 0 && (
    <section class="container-wide py-16 sm:py-24">
      <Reveal>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="section-label">Delicious</p>
            <h2 class="section-title mt-2">
              {fields?.['featured-headline'] || 'Curated culinary creations'}
            </h2>
          </div>
          <a href="/menu" class="btn-outline self-start sm:self-auto">View full menu</a>
        </div>
      </Reveal>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((dish) => {
          const imageUrl = getMediaUrl(dish.fields.image);
          const dietary = parseDietary(dish.fields.dietary);
          return (
            <Reveal>
              <article class="dish-card h-full">
                {imageUrl && (
                  <div class="aspect-[4/3] overflow-hidden">
                    <img
                      src={imageUrl}
                      alt={getMediaAlt(dish.fields.image, dish.fields.name || 'Dish')}
                      class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-display text-xl font-bold text-coal">{dish.fields.name}</h3>
                    <span class="ticket-price shrink-0">{formatPrice(dish.fields.price)}</span>
                  </div>
                  {dish.fields.description && (
                    <p class="mt-2 text-sm leading-relaxed text-forest/70">{dish.fields.description}</p>
                  )}
                  {dietary.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {dietary.map((tag) => (
                        <span class="dietary-badge">{tag}</span>
                      ))}
                    </div>
                  )}
                  <a href="/menu" class="mt-5 inline-flex text-sm font-semibold text-ember hover:!text-forest">
                    See on menu
                  </a>
                </div>
              </article>
            </Reveal>
          );
        })}
      </div>
    </section>
  )}

  {/* Gallery mosaic */}
  {galleryPreview.length > 0 && (
    <section class="bg-foam/60 py-16 sm:py-24">
      <div class="container-wide">
        <Reveal>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="section-label">Gallery</p>
              <h2 class="section-title mt-2">A delicious display</h2>
            </div>
            <a href="/gallery" class="btn-outline">View gallery</a>
          </div>

          <div class="mt-10 grid auto-rows-[10.5rem] grid-cols-2 gap-3 sm:auto-rows-[13rem] md:auto-rows-[11.5rem] md:grid-cols-4 md:gap-4">
            {galleryPreview.map((item, index) => {
              const src = getMediaUrl(item.fields.image);
              if (!src) return null;
              const tall = index === 0 || index === 3;
              return (
                <a
                  href="/gallery"
                  class:list={[
                    'group relative block overflow-hidden rounded-[1.5rem]',
                    tall ? 'row-span-2' : '',
                  ]}
                >
                  <img
                    src={src}
                    alt={getMediaAlt(item.fields.image, item.fields.caption || 'Gallery image')}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  {item.fields.caption && (
                    <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-coal/70 to-transparent px-3 pb-3 pt-8 text-sm text-foam opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                      {item.fields.caption}
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        </Reveal>
      </div>
    </section>
  )}

  {/* Private dining */}
  {privateDining?.fields && (
    <section class="container-wide py-16 sm:py-24">
      <Reveal>
        <div class="grid overflow-hidden rounded-[2rem] bg-chalk ring-1 ring-forest/10 lg:grid-cols-2">
          {getMediaUrl(privateDining.fields.image) && (
            <div class="aspect-[16/11] lg:aspect-auto lg:min-h-[22rem]">
              <img
                src={getMediaUrl(privateDining.fields.image)!}
                alt={getMediaAlt(privateDining.fields.image, 'Private dining')}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          )}
          <div class="flex flex-col justify-center p-8 sm:p-12">
            <p class="section-label">{privateDining.fields.eyebrow || 'Gatherings'}</p>
            <h2 class="section-title mt-3 text-3xl sm:text-4xl">
              {privateDining.fields.headline}
            </h2>
            {privateDining.fields.body && (
              <div class="mt-5 max-w-md">
                <RichText html={renderRichText(privateDining.fields.body)} />
              </div>
            )}
            {privateDining.fields['cta-label'] && privateDining.fields['cta-url'] && (
              <a href={privateDining.fields['cta-url']} class="btn-primary mt-8 self-start">
                {privateDining.fields['cta-label']}
              </a>
            )}
          </div>
        </div>
      </Reveal>
    </section>
  )}

  {/* Journal */}
  {journalPreview.length > 0 && (
    <section class="container-wide pb-8 sm:pb-12">
      <Reveal>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="section-label">Journal</p>
            <h2 class="section-title mt-2">Latest from the kitchen</h2>
          </div>
          <a href="/journal" class="btn-outline">View more</a>
        </div>
      </Reveal>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {journalPreview.map((post) => {
          const cover = getMediaUrl(post.fields['cover-image']);
          return (
            <Reveal>
              <a
                href={`/journal/${post.fields.slug}`}
                class="dish-card group flex h-full flex-col no-underline !text-coal sm:flex-row"
              >
                {cover && (
                  <div class="aspect-[16/11] shrink-0 overflow-hidden sm:aspect-auto sm:w-2/5">
                    <img
                      src={cover}
                      alt={getMediaAlt(post.fields['cover-image'], post.fields.title || 'Journal')}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col justify-center p-6">
                  <h3 class="font-display text-2xl font-bold tracking-tight">
                    {post.fields.title}
                  </h3>
                  {post.fields.excerpt && (
                    <p class="mt-3 text-sm leading-relaxed text-forest/70">{post.fields.excerpt}</p>
                  )}
                  <span class="mt-5 text-sm font-semibold text-ember">Read more</span>
                </div>
              </a>
            </Reveal>
          );
        })}
      </div>
    </section>
  )}

  {/* Visit CTA */}
  {(fields?.['visit-cta-headline'] || fields?.['visit-cta-body']) && (
    <section class="container-wide py-16 sm:py-24">
      <Reveal>
        <div class="relative overflow-hidden rounded-[2rem] bg-ember px-8 py-12 text-foam sm:px-14 sm:py-16">
          <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-foam/15 blur-2xl"></div>
          <div class="absolute -bottom-20 left-10 h-48 w-48 rounded-full bg-forest/25 blur-2xl"></div>
          <div class="relative grid gap-8 lg:grid-cols-[1.4fr_auto] lg:items-center">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-foam/80">Ready tonight?</p>
              <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-5xl">
                {fields?.['visit-cta-headline']}
              </h2>
              {fields?.['visit-cta-body'] && (
                <p class="mt-4 max-w-xl text-base text-foam/90">{fields['visit-cta-body']}</p>
              )}
            </div>
            <div class="flex flex-wrap gap-3">
              {fields?.['visit-cta-label'] && fields?.['visit-cta-url'] && (
                <a
                  href={fields['visit-cta-url']}
                  class="inline-flex items-center justify-center rounded-full bg-foam px-7 py-3.5 text-sm font-semibold text-ember transition hover:bg-chalk"
                >
                  {fields['visit-cta-label']}
                </a>
              )}
              <a
                href={settings?.fields['reservation-url'] || '/reserve'}
                class="inline-flex items-center justify-center rounded-full border-2 border-foam/50 px-7 py-3.5 text-sm font-semibold text-foam transition hover:border-foam hover:bg-foam/10"
                target={/^https?:\/\//i.test(settings?.fields['reservation-url'] || '') ? '_blank' : undefined}
                rel={/^https?:\/\//i.test(settings?.fields['reservation-url'] || '') ? 'noopener noreferrer' : undefined}
              >
                Reserve
              </a>
            </div>
          </div>
        </div>
      </Reveal>
    </section>
  )}
</BaseLayout>
