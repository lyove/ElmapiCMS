---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import RichText from '../components/RichText.astro';
import { getPageReserve, getSiteSettings } from '../lib/content';
import { renderRichText } from '../lib/rich-text';
import { buildSeo } from '../lib/seo';

const [settings, page] = await Promise.all([getSiteSettings(), getPageReserve()]);
const fields = page?.fields;
const sideNotesHtml = renderRichText(fields?.['side-notes']);
const successMessage =
  fields?.['success-message'] || 'Request received. We will email you to confirm.';

const seo = buildSeo({
  settings,
  page: fields,
  path: '/reserve',
  fallbackTitle: fields?.headline || 'Reserve',
  fallbackDescription: fields?.intro,
});
---

<BaseLayout settings={settings} seo={seo}>
  <section class="container-wide py-14 sm:py-20">
    <p class="section-label hero-rise">Table request</p>
    <h1 class="section-title mt-3 max-w-3xl hero-rise hero-rise-delay-1">
      {fields?.headline || 'Reserve a table'}
    </h1>
    {fields?.intro && (
      <p class="mt-4 max-w-2xl text-lg text-forest/75 hero-rise hero-rise-delay-2">{fields.intro}</p>
    )}
  </section>

  <section class="container-wide pb-24">
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
      <Reveal class="lg:col-span-7">
        <div
          id="reserve-success"
          class="hidden rounded-[1.75rem] bg-foam p-8 shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] sm:p-10"
          role="status"
        >
          <p class="section-label text-sage">Sent</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-coal">
            Thank you
          </h2>
          <p class="mt-3 text-lg text-forest/75" id="reserve-success-copy">{successMessage}</p>
          <a href="/menu" class="btn-primary mt-8">Browse the menu</a>
        </div>

        <form
          id="reserve-form"
          class="rounded-[1.75rem] bg-foam p-6 shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)] sm:p-10"
          novalidate
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label class="form-label" for="name">Name</label>
              <input class="form-input" id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="sm:col-span-1">
              <label class="form-label" for="email">Email</label>
              <input
                class="form-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="sm:col-span-1">
              <label class="form-label" for="phone">Phone</label>
              <input class="form-input" id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="sm:col-span-1">
              <label class="form-label" for="party-size">Party size</label>
              <input
                class="form-input"
                id="party-size"
                name="partySize"
                type="number"
                min="1"
                max="20"
                required
              />
            </div>
            <div class="sm:col-span-1">
              <label class="form-label" for="preferred-date">Preferred date</label>
              <input class="form-input" id="preferred-date" name="preferredDate" type="date" required />
            </div>
            <div class="sm:col-span-1">
              <label class="form-label" for="preferred-time">Preferred time</label>
              <select class="form-input" id="preferred-time" name="preferredTime" required>
                <option value="">Select a time</option>
                <option value="5:00 PM">5:00 PM</option>
                <option value="5:30 PM">5:30 PM</option>
                <option value="6:00 PM">6:00 PM</option>
                <option value="6:30 PM">6:30 PM</option>
                <option value="7:00 PM">7:00 PM</option>
                <option value="7:30 PM">7:30 PM</option>
                <option value="8:00 PM">8:00 PM</option>
                <option value="8:30 PM">8:30 PM</option>
                <option value="9:00 PM">9:00 PM</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="form-label" for="occasion">Occasion</label>
              <input
                class="form-input"
                id="occasion"
                name="occasion"
                type="text"
                placeholder="Birthday, private dining, weeknight dinner"
              />
            </div>
            <div class="sm:col-span-2">
              <label class="form-label" for="notes">Notes</label>
              <textarea
                class="form-textarea"
                id="notes"
                name="notes"
                placeholder="Dietary needs, seating preference, private dining headcount"
              ></textarea>
            </div>
          </div>

          <p id="reserve-error" class="mt-4 hidden text-sm font-medium text-ember" role="alert"></p>

          <button type="submit" class="btn-primary mt-8 w-full sm:w-auto" id="reserve-submit">
            Send request
          </button>
        </form>
      </Reveal>

      <Reveal class="lg:col-span-5">
        <div class="rounded-[1.75rem] border border-forest/10 bg-chalk/70 p-6 sm:p-8">
          <p class="section-label">Before you book</p>
          {sideNotesHtml ? (
            <div class="prose-marrow mt-4">
              <RichText html={sideNotesHtml} />
            </div>
          ) : (
            <ul class="mt-4 space-y-2 text-forest/80">
              <li>Dinner service starts at 5pm</li>
              <li>We hold reservations for 15 minutes</li>
              <li>Private dining seats up to 14</li>
            </ul>
          )}
          <div class="mt-8 space-y-2 text-sm text-forest/70">
            {settings?.fields?.phone && (
              <p>
                Call{' '}
                <a href={`tel:${settings.fields.phone.replace(/\s/g, '')}`} class="font-semibold text-ember">
                  {settings.fields.phone}
                </a>
              </p>
            )}
            <p>
              Or see <a href="/visit" class="font-semibold text-ember">hours and directions</a>.
            </p>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('reserve-form') as HTMLFormElement | null;
  const success = document.getElementById('reserve-success');
  const errorEl = document.getElementById('reserve-error');
  const submitBtn = document.getElementById('reserve-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    errorEl?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') || ''),
      email: String(data.get('email') || ''),
      phone: String(data.get('phone') || ''),
      partySize: String(data.get('partySize') || ''),
      preferredDate: String(data.get('preferredDate') || ''),
      preferredTime: String(data.get('preferredTime') || ''),
      occasion: String(data.get('occasion') || ''),
      notes: String(data.get('notes') || ''),
    };

    try {
      const res = await fetch('/api/reserve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = (await res.json()) as { ok?: boolean; error?: string };

      if (!res.ok || !json.ok) {
        throw new Error(json.error || 'Something went wrong.');
      }

      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        errorEl.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send request';
    }
  });
</script>
