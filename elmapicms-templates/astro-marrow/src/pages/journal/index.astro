---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import { getMediaAlt, getMediaUrl } from '../../lib/assets';
import { getJournalPosts, getPageJournal, getSiteSettings } from '../../lib/content';
import { buildSeo } from '../../lib/seo';

const [settings, page, posts] = await Promise.all([
  getSiteSettings(),
  getPageJournal(),
  getJournalPosts(),
]);

const fields = page?.fields;
const [featured, ...rest] = posts;

const seo = buildSeo({
  settings,
  page: fields,
  path: '/journal',
  fallbackTitle: fields?.headline || 'Journal',
  fallbackDescription: fields?.intro,
});

function formatDate(iso?: string | null): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout settings={settings} seo={seo}>
  <section class="container-wide py-14 sm:py-20">
    <p class="section-label hero-rise">From the kitchen</p>
    <h1 class="section-title mt-3 hero-rise hero-rise-delay-1">
      {fields?.headline || 'Journal'}
    </h1>
    {fields?.intro && (
      <p class="mt-4 max-w-2xl text-lg text-forest/75 hero-rise hero-rise-delay-2">{fields.intro}</p>
    )}
  </section>

  <section class="container-wide pb-24">
    {posts.length > 0 ? (
      <div class="space-y-10">
        {featured && (
          <Reveal>
            <article class="overflow-hidden rounded-[2rem] bg-foam shadow-[0_18px_50px_-32px_rgba(21,32,25,0.4)]">
              <a
                href={`/journal/${featured.fields.slug}`}
                class="grid !text-coal no-underline lg:grid-cols-2"
              >
                {getMediaUrl(featured.fields['cover-image']) && (
                  <div class="aspect-[16/11] overflow-hidden lg:aspect-auto lg:min-h-[22rem]">
                    <img
                      src={getMediaUrl(featured.fields['cover-image'])!}
                      alt={getMediaAlt(
                        featured.fields['cover-image'],
                        featured.fields.title || 'Journal post',
                      )}
                      class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                      loading="eager"
                    />
                  </div>
                )}
                <div class="flex flex-col justify-center p-8 sm:p-10">
                  <p class="section-label">Latest</p>
                  {featured.published_at && (
                    <time datetime={featured.published_at} class="mt-3 block text-sm text-forest/60">
                      {formatDate(featured.published_at)}
                    </time>
                  )}
                  <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
                    {featured.fields.title}
                  </h2>
                  {featured.fields.excerpt && (
                    <p class="mt-4 text-base leading-relaxed text-forest/75 sm:text-lg">
                      {featured.fields.excerpt}
                    </p>
                  )}
                  <span class="mt-6 inline-flex text-sm font-semibold text-ember">Read the note</span>
                </div>
              </a>
            </article>
          </Reveal>
        )}

        {rest.length > 0 && (
          <div class="grid gap-6 sm:grid-cols-2">
            {rest.map((post) => {
              const coverUrl = getMediaUrl(post.fields['cover-image']);
              return (
                <Reveal>
                  <article class="dish-card h-full">
                    <a href={`/journal/${post.fields.slug}`} class="block h-full !text-coal no-underline">
                      {coverUrl && (
                        <div class="aspect-[16/10] overflow-hidden">
                          <img
                            src={coverUrl}
                            alt={getMediaAlt(post.fields['cover-image'], post.fields.title || 'Journal post')}
                            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                            loading="lazy"
                          />
                        </div>
                      )}
                      <div class="p-6">
                        {post.published_at && (
                          <time datetime={post.published_at} class="section-label">
                            {formatDate(post.published_at)}
                          </time>
                        )}
                        <h2 class="mt-2 font-display text-2xl font-bold tracking-tight">
                          {post.fields.title}
                        </h2>
                        {post.fields.excerpt && (
                          <p class="mt-2 text-sm leading-relaxed text-forest/70">{post.fields.excerpt}</p>
                        )}
                        <span class="mt-4 inline-block text-sm font-semibold text-ember">Read more</span>
                      </div>
                    </a>
                  </article>
                </Reveal>
              );
            })}
          </div>
        )}
      </div>
    ) : (
      <p class="text-forest/70">Journal posts coming soon.</p>
    )}
  </section>
</BaseLayout>
