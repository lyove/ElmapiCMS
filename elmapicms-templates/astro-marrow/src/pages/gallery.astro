---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { getMediaAlt, getMediaUrl } from '../lib/assets';
import { getGalleryImages, getPageGallery, getSiteSettings } from '../lib/content';
import { buildSeo } from '../lib/seo';

const [settings, page, images] = await Promise.all([
  getSiteSettings(),
  getPageGallery(),
  getGalleryImages(),
]);

const fields = page?.fields;

const seo = buildSeo({
  settings,
  page: fields,
  path: '/gallery',
  fallbackTitle: fields?.headline || 'Gallery',
  fallbackDescription: fields?.intro,
});
---

<BaseLayout settings={settings} seo={seo}>
  <section class="container-wide py-14 sm:py-20">
    <p class="section-label hero-rise">Gallery</p>
    <h1 class="section-title mt-3 hero-rise hero-rise-delay-1">
      {fields?.headline || 'A delicious display'}
    </h1>
    {fields?.intro && (
      <p class="mt-4 max-w-2xl text-lg text-forest/75 hero-rise hero-rise-delay-2">{fields.intro}</p>
    )}
  </section>

  <section class="container-wide pb-20">
    {images.length > 0 ? (
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
        {images.map((entry, index) => {
          const imageUrl = getMediaUrl(entry.fields.image);
          if (!imageUrl) return null;
          const alt = getMediaAlt(entry.fields.image, entry.fields.caption || 'Gallery image');
          const tall = index % 5 === 0;
          return (
            <Reveal class="mb-4 break-inside-avoid">
              <figure class="group overflow-hidden rounded-[1.5rem] bg-foam shadow-[0_18px_50px_-30px_rgba(21,32,25,0.4)]">
                <img
                  src={imageUrl}
                  alt={alt}
                  class:list={[
                    'w-full object-cover transition-transform duration-700 group-hover:scale-105',
                    tall ? 'aspect-[3/4]' : 'aspect-[4/3]',
                  ]}
                  loading="lazy"
                />
                {entry.fields.caption && (
                  <figcaption class="px-4 py-3 text-sm text-forest/70">
                    {entry.fields.caption}
                  </figcaption>
                )}
              </figure>
            </Reveal>
          );
        })}
      </div>
    ) : (
      <p class="text-forest/70">Gallery images coming soon.</p>
    )}
  </section>
</BaseLayout>
