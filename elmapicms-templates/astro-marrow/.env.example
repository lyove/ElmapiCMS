ELMAPI_BASE_URL=https://your-instance.example/api
ELMAPI_PROJECT_ID=your-project-uuid
ELMAPI_API_KEY=your-project-api-token
PUBLIC_SITE_URL=http://localhost:4321

# CMS response cache TTL in seconds (default 3600). Set 0 for always-live reads.
CMS_CACHE_MAX_AGE=3600

# Shared secret for POST /api/revalidate (Elmapi webhook Secret field).
REVALIDATE_SECRET=

# Local Herd TLS: package.json scripts already use NODE_OPTIONS=--use-system-ca.
# Fallback if needed (shell only, never production):
# NODE_TLS_REJECT_UNAUTHORIZED=0 npm run dev
