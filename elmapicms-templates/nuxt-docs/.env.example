ELMAPI_BASE_URL=https://your-instance.example/api
ELMAPI_PROJECT_ID=your-project-uuid
ELMAPI_API_KEY=your-project-api-token

NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables webhook cache refresh via POST /api/revalidate
# REVALIDATE_SECRET=
# Optional: seconds to cache published CMS reads in-process (0 = always live)
# CMS_CACHE_MAX_AGE=3600
# Development only for self-signed TLS on local .test hosts
# NODE_TLS_REJECT_UNAUTHORIZED=0
