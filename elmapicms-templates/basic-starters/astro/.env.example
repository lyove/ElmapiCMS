# ElmapiCMS instance API root (include /api)
ELMAPI_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
ELMAPI_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only, never PUBLIC_)
ELMAPI_API_KEY=

# Optional: public site origin
PUBLIC_SITE_URL=http://localhost:4321

# Local Herd TLS: package.json scripts already use NODE_OPTIONS=--use-system-ca.
# Fallback if needed (shell only, never production):
# NODE_TLS_REJECT_UNAUTHORIZED=0 npm run dev
