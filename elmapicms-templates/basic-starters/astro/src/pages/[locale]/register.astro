---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePath } from "../../lib/i18n";
import { loadPageChrome, resolveLocale } from "../../lib/page-context";

const locale = await resolveLocale(Astro.params.locale);
const chrome = await loadPageChrome(locale, Astro.cookies);
---

<BaseLayout
  locale={locale}
  dictionary={chrome.dictionary}
  siteName={chrome.siteName}
  title={chrome.dictionary.auth.registerTitle}
  signedIn={chrome.signedIn}
>
  <div class="mx-auto max-w-sm space-y-4">
    <h1 class="text-2xl font-semibold tracking-tight">
      {chrome.dictionary.auth.registerTitle}
    </h1>
    <form
      id="register-form"
      class="space-y-4"
      data-account={localePath(locale, "/account")}
      data-login={localePath(locale, "/login")}
    >
      <div class="space-y-1.5">
        <label for="display_name" class="block text-sm font-medium"
          >{chrome.dictionary.auth.displayName}</label
        >
        <input
          id="display_name"
          name="display_name"
          type="text"
          autocomplete="name"
          class="w-full rounded border border-zinc-300 px-3 py-2 text-sm"
        />
      </div>
      <div class="space-y-1.5">
        <label for="email" class="block text-sm font-medium"
          >{chrome.dictionary.auth.email}</label
        >
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="w-full rounded border border-zinc-300 px-3 py-2 text-sm"
        />
      </div>
      <div class="space-y-1.5">
        <label for="password" class="block text-sm font-medium"
          >{chrome.dictionary.auth.password}</label
        >
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="w-full rounded border border-zinc-300 px-3 py-2 text-sm"
        />
      </div>
      <p id="register-error" class="hidden text-sm text-red-600"></p>
      <p
        id="verify-token"
        class="hidden rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"
      >
      </p>
      <button
        type="submit"
        class="w-full rounded bg-zinc-900 px-3 py-2 text-sm font-medium text-white disabled:opacity-50"
      >
        {chrome.dictionary.auth.submitRegister}
      </button>
    </form>
    <p class="text-sm text-zinc-600">
      {chrome.dictionary.auth.hasAccount}
      <a href={localePath(locale, "/login")} class="underline underline-offset-2">
        {chrome.dictionary.nav.login}
      </a>
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById(
    "register-form",
  ) as HTMLFormElement | null;
  const errorEl = document.getElementById("register-error");
  const verifyEl = document.getElementById("verify-token");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector("button[type=submit]") as HTMLButtonElement;
    submit.disabled = true;
    errorEl?.classList.add("hidden");
    verifyEl?.classList.add("hidden");
    const fd = new FormData(form);
    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: String(fd.get("email") || ""),
          password: String(fd.get("password") || ""),
          display_name: String(fd.get("display_name") || ""),
        }),
      });
      const data = (await res.json()) as {
        error?: string;
        verification_required?: boolean;
        verification_token?: string;
        user?: unknown;
      };
      if (!res.ok) {
        if (errorEl) {
          errorEl.textContent = data.error || "Registration failed.";
          errorEl.classList.remove("hidden");
        }
        submit.disabled = false;
        return;
      }
      if (data.verification_required) {
        if (verifyEl) {
          verifyEl.innerHTML = `Email verification is required. Your app owns delivery of this token: <code class="break-all">${data.verification_token || "(no token returned)"}</code>`;
          verifyEl.classList.remove("hidden");
        }
        submit.disabled = false;
        return;
      }
      if (data.user) {
        window.location.href = form.dataset.account || "/";
        return;
      }
      window.location.href = form.dataset.login || "/";
    } catch {
      if (errorEl) {
        errorEl.textContent = "Network error.";
        errorEl.classList.remove("hidden");
      }
      submit.disabled = false;
    }
  });
</script>
