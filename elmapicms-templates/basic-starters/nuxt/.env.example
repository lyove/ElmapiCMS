# ElmapiCMS instance API root (include /api)
ELMAPI_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
ELMAPI_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only, never public)
ELMAPI_API_KEY=

# Optional: public site origin (maps to runtimeConfig.public.siteUrl)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional hosted overrides (same values as ELMAPI_* above):
# NUXT_ELMAPI_BASE_URL=
# NUXT_ELMAPI_PROJECT_ID=
# NUXT_ELMAPI_API_KEY=

# Node.js: set to 0 only for local dev with self-signed TLS (e.g. Laravel Herd)
# NODE_TLS_REJECT_UNAUTHORIZED=0
